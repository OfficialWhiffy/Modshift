<Window x:Class="TruckModsListUpdater.App.Views.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TruckModsListUpdater.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:InstallViewModel}"
        Title="Install mods" Width="900" Height="600" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="These mods were found. Choose what to do with each one." Style="{StaticResource SectionHeader}" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Candidates}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:InstallCandidateViewModel}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Border Width="80" Height="47" CornerRadius="3" ClipToBounds="True" Background="#22808080" Margin="0,0,12,0">
                            <Image Source="{Binding IconPath, Converter={StaticResource ThumbConverter}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                <Run Text="{Binding Version, Mode=OneWay, StringFormat='  {0}'}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BannerBrush}" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ComboBox Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,6" BorderThickness="1" CornerRadius="4" BorderBrush="{StaticResource BannerBrush}"
                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Skipped:" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <CheckBox IsChecked="{Binding EnableInProfile}" Content="{Binding EnableText}"
                      Visibility="{Binding CanEnable, Converter={StaticResource BoolToVisibility}}" />
            <CheckBox IsChecked="{Binding UpdateProfiles}" Margin="0,4,0,0"
                      Content="Update profiles that use a replaced version to the new one (keeps its place in the load order)"
                      Visibility="{Binding HasReplacements, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Install" IsDefault="True" MinWidth="110" FontWeight="SemiBold" Click="OnInstall" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
