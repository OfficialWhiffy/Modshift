<?xml version="1.0" encoding="utf-8"?>
<!-- The release build: one self-contained exe, so users do not have to install the .NET runtime.
     Use: dotnet publish src/TruckModsListUpdater.App -c Release -p:PublishProfile=win-x64 -o ./publish -->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compresses the bundled runtime: about 134 MB uncompressed, about 59 MB compressed. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Drops the localised resource assemblies of the runtime and packages (Modshift's UI is English). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- Never enable PublishTrimmed: WPF does not support trimming (the SDK refuses, and forcing it breaks
         text boxes and drag-and-drop at runtime). See CONTRIBUTING.md "Releasing". -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
