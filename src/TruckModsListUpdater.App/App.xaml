<Application x:Class="TruckModsListUpdater.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TruckModsListUpdater.App.Views"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <views:IconPathConverter x:Key="IconConverter" />
            <views:IconPathConverter x:Key="ThumbConverter" DecodeWidth="92" />
            <views:SeverityBrushConverter x:Key="SeverityBrush" />
            <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <views:FilterNameConverter x:Key="FilterName" />
            <views:IndentMarginConverter x:Key="IndentMargin" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Accent from the original TruckModsListUpdater dark theme. -->
            <SolidColorBrush x:Key="BannerBrush" Color="#F2A93B" />

            <!-- The game's description colours, lightened to read well on the dark background. -->
            <SolidColorBrush x:Key="DescOrangeBrush" Color="#F2A93B" />
            <SolidColorBrush x:Key="DescBlueBrush" Color="#6CB6FF" />
            <SolidColorBrush x:Key="DescRedBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="DescGreenBrush" Color="#7BD88F" />
            <SolidColorBrush x:Key="DescYellowBrush" Color="#FFE066" />
            <SolidColorBrush x:Key="DescWhiteBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DescPurpleBrush" Color="#C79BFF" />

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
