<Window x:Class="TruckModsListUpdater.ProfileCopy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TruckModsListUpdater.ProfileCopy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Modshift Profile Copy"
        Width="900" Height="780" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="ProfileTemplate" DataType="{x:Type vm:ProfileOption}">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Game -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <ComboBox DockPanel.Dock="Left" Width="260" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                      DisplayMemberPath="Game.DisplayName" ToolTip="Game" />
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                    ToolTip="Read the profiles and their settings again" />
        </DockPanel>

        <!-- Game running -->
        <Border Grid.Row="1" Background="{StaticResource BannerBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Banner}" Foreground="Black" TextWrapping="Wrap" />
        </Border>

        <!-- From / to -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Copy from" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Source}" ItemTemplate="{StaticResource ProfileTemplate}" />
            </StackPanel>
            <Button Grid.Column="1" Content="⇄" FontSize="16" Margin="12,0" VerticalAlignment="Bottom" MinWidth="44"
                    Command="{Binding SwapCommand}" ToolTip="Swap the two profiles" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="Copy to" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Target}" ItemTemplate="{StaticResource ProfileTemplate}" />
            </StackPanel>
        </Grid>

        <!-- What to copy -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="What to copy" Style="{StaticResource SectionHeader}" />
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryOption}">
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2,12,2">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Preview -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource SectionHeader}" />
            <ListView ItemsSource="{Binding Files}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Settings" Width="180" DisplayMemberBinding="{Binding Category}" />
                        <GridViewColumn Header="File" Width="240" DisplayMemberBinding="{Binding FileName}" />
                        <GridViewColumn Header="What happens" Width="170" DisplayMemberBinding="{Binding Action}" />
                        <GridViewColumn Header="Where" Width="200" DisplayMemberBinding="{Binding Folder}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <!-- Copy -->
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Copy settings" Command="{Binding CopyCommand}"
                    Padding="18,6" FontWeight="SemiBold" Background="{StaticResource BannerBrush}" Foreground="Black" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Text="Files the target has but the source does not are kept. Mod lists, saves and profile.sii are never changed."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Restore -->
        <StackPanel Grid.Row="6" Margin="0,16,0,0">
            <TextBlock Text="Backups of the target profile" Style="{StaticResource SectionHeader}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenBackupsFolderCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Restore" Command="{Binding RestoreCommand}" Margin="8,0,0,0"
                        ToolTip="Put the target's settings back as they were before that change" />
                <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberPath="Title" />
            </DockPanel>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="7" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
