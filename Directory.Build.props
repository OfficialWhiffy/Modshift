<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>OfficialWhiffy</Authors>
    <Product>Modshift</Product>
    <Copyright>Copyright (c) 2025-2026 OfficialWhiffy</Copyright>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The version comes from the git tag (vMAJOR.MINOR.PATCH[-suffix]); see CONTRIBUTING.md "Releasing". -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
